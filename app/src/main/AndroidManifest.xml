<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- Android 13 (API 33) 起，发通知必须同时具备这两条：
         ① manifest 声明 POST_NOTIFICATIONS（否则 NotificationManager.notify 直接被丢）
         ② 运行时用户授权（否则通知栏里什么都不出现）
         Bug 2「焦点通知开关无作用、通知栏没有耳机控制卡片」的第一层根因就是这里缺失。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 部分 ROM 上焦点通知（MIUI 强提示）还会检查 FOREGROUND_SERVICE，
         这里一并声明，避免被 NotificationManager 的服务白名单拦下。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <package android:name="com.android.bluetooth" />
        <package android:name="com.android.settings" />
        <package android:name="com.fengeek.f002" />
    </queries>

    <application
        android:name=".FiilPodsApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.FiilPods">

        <activity-alias
            android:name=".LauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PopupActivity"
            android:theme="@style/Theme.FiilPods.Popup"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="moe.chenxy.fiilpods.action.SHOW_PODS_UI" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 自定义耳机图片的 ContentProvider。
             移植 OppoPods 时漏了这一条声明，导致用户一旦设置了自定义耳机图片，
             imageUri() 生成的 content://moe.chenxy.fiilpods.podimages/... 无人应答，
             AsyncImage 直接抛 ActivityNotFoundException。 -->
        <provider
            android:name=".config.PodImageProvider"
            android:authorities="moe.chenxy.fiilpods.podimages"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- Set as Xposed Module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="FIIL Earphones Support for Xiaomi HyperOS." />

        <meta-data
            android:name="xposedminversion"
            android:value="101" />

        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
    </application>

</manifest>
